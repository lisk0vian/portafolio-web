---
// Home (portfolio) template, shared by the "es" and "en" pages.
// DI: recibe `sourceKind` por props (mock|live). Default = composition por env.
// Astro resuelve copy en build y embebe JSON para switches de perfil en cliente.
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import SectionHead from "./SectionHead.astro";
import Terminal from "./Terminal.astro";
import SectionDock from "./SectionDock.astro";
import { icon } from "../utils/icons";
import { ui, profiles, education, certGroupFallback, pick, type Profile } from "../data/content";
import type { Lang } from "../scripts/store";
import { resolvePersonal } from "../utils/personal";
import { pageUrl, altPageUrl } from "../utils/urls";
import { site } from "../data/site";
import type { TermData } from "../scripts/terminal";
import { resolveSourceKind, type SourceKind } from "../lib/composition";
import { workHtml, releaseHeroHtml, aboutHtml, factsHtml, quoteHtml, principlesHtml, nowHtml, directoryHtml, pubFiltersHtml, pubsHtml, expHtml, eduHtml, certRowClass } from "../scripts/home-render";

interface Props {
  lang: Lang;
  sourceKind?: SourceKind;
}

const { lang, sourceKind = resolveSourceKind() } = Astro.props;
const t = pick(ui, lang);
const getProfileData = (profile: Profile) => pick(profiles[profile], lang);
const withNumbers = (projects: any[]) => projects.map((x: any, i: number) => ({ ...x, no: "0" + (i + 1) }));
const personal = resolvePersonal(lang);
const caseHref = pageUrl(lang, "case");
const systemHref = pageUrl(lang, "system");
const langAltUrl = altPageUrl(lang, "home");

const resolved = {
  fullstack: { ...getProfileData("fullstack"), projects: withNumbers(getProfileData("fullstack").projects), certs: [], certGroups: [] },
  data: { ...getProfileData("data"), projects: withNumbers(getProfileData("data").projects), certs: [], certGroups: [] },
};

const termFor = (profile: Profile): TermData => {
  const pp = resolved[profile];
  return {
    name: personal.name,
    role: pp.role,
    bio: pp.intro,
    projects: pp.projects,
    stack: pp.stack,
    email: personal.email,
    links: pp.links.map((id: string) => (id === "cv" ? site.socials.cv.label : site.socials[id].label)),
    profile,
    theme: "light",
    lang,
    langAltUrl,
  };
};
const termDataMap = { fullstack: termFor("fullstack"), data: termFor("data") };

const p = resolved.fullstack;
// Formación por edición (Ingeniería / Datos); la global queda de respaldo.
const edu = p.edu ?? pick(education, lang);
const certsBase = pageUrl(lang, "certs").replace(/\/+$/, "");

// Locale-resolved payload for client-side profile switches (no { es, en } pairs left).
const pageData = {
  ui: t,
  fullstack: resolved.fullstack,
  data: resolved.data,
  edu,
  personal,
  meta: { lang, homeUrl: pageUrl(lang, "home"), caseHref, certsUrl: pageUrl(lang, "certs"), sourceKind },
};
const contentJson = JSON.stringify(pageData);

// Mismo marcado que el re-render en cliente (scripts/home-render.ts).
const pubState0 = { type: "all", year: "all", open: [], bib: [] };
const personalFull = { ...personal, hoursNote: t.hoursNote };
const counts = { fullstack: resolved.fullstack.projects.length, data: resolved.data.projects.length };
const html = {
  hero: releaseHeroHtml(p.projects, t, { caseHref, cvUrl: personal.cvUrl, name: personal.name, role: p.role, availability: personal.availabilityLong, location: personal.location, intro: p.intro, profile: "fullstack", counts }),
  work: workHtml(p.projects, t, { caseHref, open: 0, profile: "fullstack", counts, cvUrl: personal.cvUrl }),
  about: aboutHtml(p.about),
  facts: factsHtml(t.facts),
  quote: quoteHtml(p),
  principles: principlesHtml(p, t),
  now: nowHtml(p, t, lang),
  directory: directoryHtml(personalFull, p.links, t),
  pubFilters: pubFiltersHtml(p.pubs, t, pubState0),
  pubs: pubsHtml(p.pubs, t, pubState0, personal.name),
};
const termJson = JSON.stringify(termDataMap);
---

<Layout title={`${personal.name} — ${p.role}`} description={p.intro} lang={lang}>
  <div data-boot hidden class="fixed inset-0 z-50 bg-paper flex items-center justify-center font-mono text-[13px] tracking-[0.14em] text-ink transition-transform duration-700 ease-[cubic-bezier(.76,0,.24,1)]" aria-hidden="true">
    <span><span data-boot-n class="tabular-nums">0</span>%</span>
  </div>
  <script is:inline>
    (function () {
      var el = document.querySelector("[data-boot]");
      try {
        if (!el || sessionStorage.getItem("mg-boot") || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        sessionStorage.setItem("mg-boot", "1");
      } catch (e) { return; }
      el.hidden = false;
      var n = el.querySelector("[data-boot-n]"), t0 = performance.now();
      function tick(now) {
        var k = Math.min(1, (now - t0) / 900);
        n.textContent = String(Math.round(100 * (1 - Math.pow(1 - k, 3))));
        if (k < 1) return requestAnimationFrame(tick);
        el.style.transform = "translateY(-100%)";
        setTimeout(function () { el.remove(); }, 750);
      }
      requestAnimationFrame(tick);
      el.addEventListener("click", function () { el.remove(); });
    })();
  </script>

  <div data-release class="min-h-screen bg-paper text-ink font-sans antialiased">
    <SiteHeader lang={lang} page="home" themeLabels={`${t.light}|${t.dark}`} spyFallback={p.role} />

    {/* § 00 — Hero: identidad + escenario de la mascota; en lg ocupa justo la primera pantalla. */}
    <section data-hero class="relative flex min-h-[calc(100svh-3.5rem)] lg:h-[calc(100svh-3.5rem)] lg:min-h-[560px] flex-col border-b border-rule">
      <div class="w-full max-w-page mx-auto px-[clamp(16px,3vw,40px)] pt-[clamp(10px,1.6vh,18px)] flex min-h-0 flex-1 flex-col">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pb-3 border-b border-rule">
          <p class="flex items-center gap-3 font-mono text-label uppercase text-ink-2 m-0">
            <span class="size-2 bg-signal motion-safe:animate-pulse" aria-hidden="true"></span><span>{personal.availabilityLong}</span>
          </p>
          <a href="#trabajo" class="flex items-center gap-2 no-underline font-mono text-label uppercase text-ink-2 hover:text-accent">
            <span data-t="ui.relAll">{t.relAll}</span><Fragment set:html={icon("arrow-down", "size-3.5")} />
          </a>
        </div>
        <div id="hero-work" class="flex min-h-0 flex-1 flex-col" set:html={html.hero} />
      </div>
    </section>

    {/* Mascota: fija; mascot.ts la posa sobre el hueco del hero y la lleva a la esquina al bajar. */}
    <button type="button" data-mascot hidden aria-label={t.mascotLabel} data-label={t.mascotLabel} data-label-menu={t.mascotMenuLabel} data-label-restore={t.mascotRestore} aria-controls="mascot-menu" class="fixed left-0 top-0 z-40 origin-top-left p-0 border-0 bg-transparent cursor-pointer will-change-transform">
      <span data-mascot-art class="block size-full"></span>
    </button>
    <p data-mascot-say aria-hidden="true" hidden class="mg-say"></p>
    <div id="mascot-menu" data-mascot-menu hidden class="mg-mascot-menu">
      <button type="button" data-mascot-cmd="wave">{t.actWave}</button>
      <button type="button" data-mascot-cmd="top">{t.mTop}</button>
      <button type="button" data-mascot-cmd="next">{t.mNext}</button>
      <button type="button" data-mascot-cmd="console">{t.mConsole}</button>
      <button type="button" data-mascot-cmd="theme">{t.mTheme}</button>
      <button type="button" data-mascot-cmd="min">{t.mMin}</button>
    </div>

    <main class="max-w-page mx-auto px-[clamp(16px,3vw,40px)]">
      {/* § 00 — Consola: capítulo como los demás, sobre el fondo de la página; la
          terminal es una ventana oscura y la chuleta de la izquierda la maneja. */}
      <section id="consola" class="pt-[clamp(64px,8vw,128px)] scroll-mt-14">
        <SectionHead num="00" metaKey="ui.consM" metaFallback={t.consM} titleKey="ui.consT" titleFallback={t.consT} />
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.5fr)] gap-x-[clamp(32px,5vw,80px)] gap-y-10 items-start">
          <div data-reveal="0" class="flex flex-col gap-5">
            <p data-t="ui.consTitle" class="text-lead font-medium m-0 text-balance">{t.consTitle}</p>
            <p data-t="ui.consNote" class="text-[15px] leading-[1.6] text-ink-2 m-0 max-w-[46ch]">{t.consNote}</p>
            <ul id="cons-cmds" class="m-0 p-0 list-none border-t border-rule">
              {t.consCmds.map((x: { c: string; d: string }) => (
                <li class="border-b border-rule">
                  <button type="button" data-term-run={x.c} class="group w-full grid grid-cols-[minmax(0,140px)_minmax(0,1fr)_auto] items-baseline gap-4 py-3 px-0 border-0 bg-transparent text-left">
                    <code class="font-mono text-[13px] text-accent whitespace-nowrap"><span aria-hidden="true">❯ </span>{x.c}</code>
                    <span class="text-[14px] text-ink-2 transition-colors group-hover:text-ink">{x.d}</span>
                    <Fragment set:html={icon("arrow-right", "size-3.5 text-ink-2")} />
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <figure data-reveal="120" class="min-w-0 m-0">
            <Terminal data={termDataMap.fullstack} height={300} id="term-main" />
            <figcaption data-t="ui.fig0" class="mg-figcaption">{t.fig0}</figcaption>
          </figure>
        </div>
      </section>

      {/* § 01 — Release notes */}
      <section id="trabajo" class="min-h-[calc(100svh-3.5rem)] pt-[clamp(56px,7vw,104px)] pb-10 scroll-mt-14">
        <SectionHead num="01" metaKey="ui.s1m" metaFallback={t.s1m} titleKey="ui.s1t" titleFallback={t.s1t} />
        <div id="projects-list" set:html={html.work} />
      </section>

      {/* § 02 — About */}
      <section id="sobre-mi" class="min-h-[calc(100svh-3.5rem)] pt-[clamp(64px,8vw,128px)] pb-10 scroll-mt-14">
        <SectionHead num="02" metaKey="ui.abM" metaFallback={t.abM} titleKey="ui.abT" titleFallback={t.abT} />
        <div class="flex flex-wrap gap-y-12 gap-x-[clamp(32px,5vw,80px)] items-start">
          <div class="flex-[0_1_340px] min-w-[250px] flex flex-col gap-8 min-[1100px]:sticky min-[1100px]:top-24">
            <figure data-reveal="0" class="m-0">
              <div data-dither-frame data-state="loading" class="group mg-cross relative aspect-[4/5] border border-rule bg-paper-2">
                <canvas data-dither-src="/retrato.jpg" role="img" aria-label={t.portraitCap} class="absolute inset-0 w-full h-full"></canvas>
                <span class="absolute inset-0 hidden group-data-[state=empty]:flex items-center justify-center font-mono text-label uppercase text-ink-2"><span data-t="ui.portrait">{t.portrait}</span></span>
              </div>
              <figcaption class="mg-figcaption mt-3"><span class="text-ink">Fig. 2 —</span>{` `}<span data-t="ui.portraitCap">{t.portraitCap}</span></figcaption>
            </figure>
            <dl id="about-facts" data-reveal="80" class="m-0 flex flex-col border-t border-rule" set:html={html.facts} />
          </div>

          <div class="flex-[1_1_480px] min-w-0 flex flex-col gap-[clamp(48px,5vw,72px)]">
            <div data-reveal="60" class="flex flex-col gap-4">
              <p class="text-lead font-medium m-0 text-balance">
                <span data-tp="h1a">{p.h1a}</span>{` `}<em data-tp="h1em" class="not-italic text-accent">{p.h1em}</em>{` `}<span data-tp="h1b">{p.h1b}</span>
              </p>
              <p data-tp="intro" class="text-[16px] leading-[1.6] text-ink-2 m-0 max-w-[58ch] text-pretty">{p.intro}</p>
            </div>
            <div data-reveal="100" class="flex flex-wrap gap-y-8 gap-x-[clamp(28px,3vw,48px)] items-start">
              <div id="about-list" class="flex-[1_1_380px] min-w-0 max-w-[620px] flex flex-col gap-5" set:html={html.about} />
              <aside class="flex-[0_1_210px] min-w-[190px] flex flex-col gap-4">
                <div data-t="ui.notes" class="font-mono text-label uppercase text-ink-2">{t.notes}</div>
                <div id="notes-list" class="flex flex-col gap-4">
                  {p.notes.map((nt: any) => (
                    <div class="flex gap-2.5 border-t border-rule pt-2.5">
                      <span class="font-mono text-[11px] text-accent">{nt.n}</span>
                      <span class="text-[14px] leading-[1.5] text-ink-2">{nt.t}</span>
                    </div>
                  ))}
                </div>
              </aside>
            </div>

            <blockquote id="about-quote" data-reveal="0" class="m-0 py-[clamp(28px,3.5vw,44px)] border-y border-rule grid grid-cols-[auto_minmax(0,1fr)] gap-x-5" set:html={html.quote} />
            <div id="about-principles" data-reveal="0" set:html={html.principles} />
            <div id="about-now" data-reveal="0" class="mg-cross border border-rule bg-paper-2 p-[clamp(20px,2.4vw,32px)]" set:html={html.now} />
          </div>
        </div>
      </section>

      {/* § 03 — Capacidades: habilidades por área + registro de credenciales */}
      <section id="herramientas" class="min-h-[calc(100svh-3.5rem)] pt-[clamp(64px,8vw,128px)] pb-[clamp(56px,7vw,104px)] scroll-mt-14">
        <SectionHead num="03" metaKey="ui.s2m" metaFallback={t.s2m} titleKey="ui.s2t" titleFallback={t.s2t} />

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-[clamp(40px,6vw,96px)] gap-y-12">
          <div class="min-w-0">
            <div class="flex flex-wrap justify-between items-baseline gap-x-4 gap-y-2 pb-3 border-b border-rule font-mono text-label uppercase text-ink-2">
              <span data-t="ui.skillT">{t.skillT}</span>
              <span id="skill-total" class="tabular-nums"></span>
            </div>
            <div id="skill-areas" class="flex flex-wrap items-center gap-x-1 gap-y-2 py-3.5 border-b border-rule"></div>
            <div id="stack-grid" class="mt-1"></div>
          </div>
          <div id="certs-col" data-reveal="100" class="min-w-0 flex flex-col gap-[clamp(36px,4vw,56px)] lg:sticky lg:top-24 lg:self-start">
            <div>
            <div class="flex flex-wrap justify-between items-baseline gap-x-4 gap-y-2 pb-3 border-b border-rule font-mono text-label uppercase text-ink-2">
              <span data-t="ui.certsT">{t.certsT}</span><span id="cert-total" class="tabular-nums"></span>
            </div>
            <div id="certs-teaser">
              {certGroupFallback.map((g: string) => (
                <a href={`${certsBase}?grupo=${g}`} class={certRowClass}>
                  <span class="min-w-0 flex flex-col gap-1.5">
                    <span class="flex items-baseline gap-2.5">
                      <span translate="no" class="font-display font-medium text-[22px] leading-[1.1] uppercase">{g}</span>
                      <span data-cert-count={g} class="font-mono text-[11px] text-accent tabular-nums"></span>
                    </span>
                    <span data-cert-latest={g} class="text-[14px] text-ink-2 truncate"></span>
                  </span>
                  <span class="flex flex-col items-end justify-between gap-2">
                    <span data-cert-range={g} class="font-mono text-[12px] text-ink-2 tabular-nums"></span>
                    <Fragment set:html={icon("arrow-right", "size-5")} />
                  </span>
                </a>
              ))}
            </div>
            <a href={certsBase} class="mg-btn-primary mt-5"><span data-t="ui.certsSeeAll">{t.certsSeeAll}</span><Fragment set:html={icon("arrow-right", "size-4 text-accent")} /></a>
            </div>

            {/* Mapa del stack: una barra por área (relleno = uso diario); filtra la lista. */}
            <div>
              <div class="flex flex-wrap justify-between items-baseline gap-x-4 gap-y-2 pb-3 border-b border-rule font-mono text-label uppercase text-ink-2">
                <span data-t="ui.mapT">{t.mapT}</span>
                <span class="flex items-center gap-4">
                  <span class="flex items-center gap-1.5"><span aria-hidden="true" class="size-[7px] bg-accent"></span><span data-t="ui.mapDaily">{t.mapDaily}</span></span>
                  <span class="flex items-center gap-1.5"><span aria-hidden="true" class="size-[7px] shadow-[inset_0_0_0_1px_var(--color-ink-2)]"></span><span data-t="ui.mapOcc">{t.mapOcc}</span></span>
                </span>
              </div>
              <div id="skill-map" class="flex flex-col py-2 border-b border-rule"></div>
              <dl id="skill-stats" class="m-0 grid grid-cols-3 border-b border-rule"></dl>
              <p data-t="ui.mapHint" class="mg-figcaption">{t.mapHint}</p>
            </div>
          </div>
        </div>
      </section>

      {/* § 04 — Investigación: bibliografía con filtros en línea */}
      <section id="investigacion" class="min-h-[calc(100svh-3.5rem)] pt-[clamp(64px,8vw,128px)] pb-10 scroll-mt-14">
        <SectionHead num="04" metaKey="ui.wrM" metaFallback={t.wrM} titleKey="ui.wrT" titleFallback={t.wrT} />
        <div id="pubs-filters" class="flex flex-wrap items-center gap-x-7 gap-y-3 py-3.5 border-y border-rule" set:html={html.pubFilters} />
        <div id="pubs-list" set:html={html.pubs} />
      </section>

      {/* § 05 — Trayectoria: línea de tiempo + formación */}
      <section id="trayectoria" class="min-h-[calc(100svh-3.5rem)] pt-[clamp(64px,8vw,128px)] pb-10 scroll-mt-14">
        <SectionHead num="05" metaKey="ui.s3m" metaFallback={t.s3m} titleKey="ui.s3t" titleFallback={t.s3t} />

        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-x-[clamp(40px,6vw,96px)] gap-y-12">
          <div class="min-w-0">
            <div data-t="ui.expT" class="font-mono text-label uppercase text-ink-2 pb-3 border-b border-rule">{t.expT}</div>
            <div id="exp-list" class="mt-1" set:html={expHtml(p.exp, t)} />
          </div>

          <aside class="min-w-0 lg:sticky lg:top-24 self-start">
            <div data-t="ui.eduT" class="font-mono text-label uppercase text-ink-2 pb-3 border-b border-rule">{t.eduT}</div>
            <div id="edu-list" class="mt-8" set:html={eduHtml(edu)} />
            <div class="mt-10">
              <a id="exp-cv" href={personal.cvUrl} class="mg-btn-solid"><span data-t="ui.cvFull">{t.cvFull}</span><Fragment set:html={icon("arrow-down", "size-4")} /></a>
            </div>
          </aside>
        </div>
      </section>
    </main>

    {/* § 06 — Correspondence: mismo tema que la página */}
    <section id="contacto" class="min-h-[calc(100svh-3.5rem)] flex items-center bg-paper text-ink border-t border-rule scroll-mt-14">
      <div class="w-full max-w-page mx-auto px-[clamp(16px,3vw,40px)] pt-[clamp(64px,8vw,128px)] pb-[clamp(64px,8vw,112px)]">
        <SectionHead num="06" metaKey="ui.s4m" metaFallback={t.s4m} titleKey="ui.s4t" titleFallback={t.s4t} />
        <div class="flex flex-wrap gap-y-14 gap-x-[clamp(40px,6vw,112px)] items-start">
          <div data-reveal="60" class="flex-[1.5_1_460px] min-w-0 flex flex-col gap-7">
            <span data-t="ui.salute" class="font-mono text-label uppercase text-ink-2">{t.salute}</span>
            <p id="letter" data-tp="letter" data-rise class="font-sans font-medium text-quote tracking-[-0.02em] m-0 max-w-[30ch] text-pretty">{p.letter}</p>
            <div class="flex flex-col gap-1.5 mt-2">
              <span data-t="ui.sign" class="text-[15px] text-ink-2">{t.sign}</span>
              <span class="font-display font-semibold text-[22px] uppercase tracking-[-0.02em]">{personal.name}</span>
              <span data-tp="role" class="font-mono text-label uppercase text-ink-2">{p.role}</span>
            </div>
            <p class="text-[15px] leading-[1.55] text-ink-2 mt-3 mb-0 pt-4 border-t border-rule max-w-[52ch]">
              <strong data-t="ui.psL" class="font-semibold text-ink">{t.psL}</strong>{` `}<span data-t="ui.ps">{t.ps}</span>
            </p>
          </div>
          <aside id="contact-dir" data-reveal="160" class="flex-[1_1_340px] min-w-0 flex flex-col gap-9" set:html={html.directory} />
        </div>
      </div>
    </section>

    <footer class="border-t border-rule">
      <div class="max-w-page mx-auto px-[clamp(16px,3vw,40px)] pt-4 pb-5">
        <p data-t="ui.sampleNotice" class="text-[13px] leading-[1.5] text-ink-2 m-0 max-w-[96ch]">{t.sampleNotice}</p>
      </div>
      <div class="max-w-page mx-auto px-[clamp(16px,3vw,40px)] pt-5 pb-24 flex flex-wrap justify-between gap-x-6 gap-y-2.5 font-mono text-[11px] tracking-[0.1em] uppercase text-ink-2">
        <span>© 2026 {personal.name}</span>
        <span id="api-status" data-state="local">datos locales</span>
        <span><span data-t="ui.trophies">{t.trophies}</span> <span data-trophies class="text-accent tabular-nums">0/10</span></span>
        <span data-t="ui.foot1">{t.foot1}</span>
        <div class="flex gap-5">
          <a href={systemHref} class="flex items-center gap-1.5 no-underline"><span data-t="ui.ds">{t.ds}</span><Fragment set:html={icon("arrow-up-right", "size-3.5")} /></a>
          <a href={caseHref} class="flex items-center gap-1.5 no-underline"><span data-t="ui.cs">{t.cs}</span><Fragment set:html={icon("arrow-up-right", "size-3.5")} /></a>
        </div>
      </div>
    </footer>

    <SectionDock items={t.index} label={t.sections} cmdLabel={t.cmdHint} />
  </div>

  <script type="application/json" id="mg-content" set:html={contentJson} />
  <script type="application/json" id="mg-terminals" set:html={termJson} />
  <script>
    import { initSite, stagger, type PageData } from "../scripts/site";
    import { initMascot } from "../scripts/mascot";
    import { initTerminals } from "../scripts/terminal";
    import { refreshHomeFromApi } from "../scripts/api-live";
    import { createPortfolioSource } from "../lib/composition";
    import { getProfile, setProfile, type Profile } from "../scripts/store";
    import { esc, workHtml, releaseHeroHtml, aboutHtml, factsHtml, quoteHtml, principlesHtml, nowHtml, directoryHtml, pubFiltersHtml, pubsHtml, expHtml, eduHtml, certRowClass, type PubState } from "../scripts/home-render";
    import { initDither } from "../scripts/dither";
    import { initTrophies } from "../scripts/terminal";
    import { icon } from "../utils/icons";

    const page = JSON.parse(document.getElementById("mg-content")!.textContent || "{}") as PageData;
    window.__mgTermData = JSON.parse(document.getElementById("mg-terminals")!.textContent || "{}");

    const caseHref = page.meta.caseHref as string;

    // Habilidades: filtro por área + puntos de validación + rango de años.
    const skillUI = { area: "all", more: new Set<string>() };
    const SKILL_PREVIEW = 8;

    function normSkill(s: string) {
      return String(s).toLowerCase().replace(/[^a-z0-9+#]/g, "");
    }

    function renderStack(pg: PageData, profile: Profile) {
      const gridEl = document.getElementById("stack-grid");
      const areasEl = document.getElementById("skill-areas");
      const totalEl = document.getElementById("skill-total");
      if (!gridEl || !areasEl) return;
      const p = (pg as any)[profile] as any;
      const ui = (pg as any).ui || {};
      const groups = p.stack || [];
      // Años de certificación por skill: rango de los certs vivos que la nombran.
      const years: Record<string, string[]> = {};
      (p.certs || []).forEach((c: any) => {
        const y = String(c.date || "").slice(0, 4);
        if (!y) return;
        (c.skills || []).forEach((s: string) => {
          const n = normSkill(s);
          if (n.length < 2) return;
          (years[n] ||= []).push(y);
        });
      });
      const match = (item: string) => {
        const parts = String(item).toLowerCase().split("/");
        let hit = false;
        for (const n of Object.keys(years)) {
          if (parts.some((part) => {
            const k = normSkill(part);
            return k.length >= 2 && (k.includes(n) || n.includes(k));
          })) hit = true;
        }
        return hit;
      };
      const yearLabel = (item: string) => {
        const found: string[] = [];
        for (const [n, ys] of Object.entries(years)) {
          const parts = String(item).toLowerCase().split("/");
          if (parts.some((part) => {
            const k = normSkill(part);
            return k.length >= 2 && (k.includes(n) || n.includes(k));
          })) found.push(...ys);
        }
        if (found.length === 0) return "";
        const uniq = [...new Set(found)].sort();
        return uniq.length === 1 ? uniq[0] : `${uniq[0]}–${String(uniq[uniq.length - 1]).slice(2)}`;
      };

      // API: `meta` trae uso diario y años (5.10); sin ella, heurística por certificados.
      const isDaily = (g: any, it: string) => {
        const m = (g.meta || []).find((x: any) => x.name === it);
        return m ? !!m.daily : match(it);
      };
      const yearUnit = (pg.meta as any)?.lang === "en" ? "y" : "a";
      const total = groups.reduce((n: number, g: any) => n + (g.items?.length ?? 0), 0);
      if (totalEl) totalEl.textContent = `${total} ${ui.skillT || ""}`.toLowerCase();

      const areas: { k: string; label: string; n: number }[] = [
        { k: "all", label: ui.pubAll || "All", n: total },
        ...groups.map((g: any) => ({ k: String(g.g), label: String(g.g), n: g.items?.length ?? 0 })),
      ];
      areasEl.innerHTML = `<span class="font-mono text-label uppercase text-ink-2 mr-2">${esc(ui.skillArea || "Área")}</span>`
        + areas.map((o) => {
          const active = skillUI.area === o.k;
          return `<button type="button" data-skill-area="${esc(o.k)}" aria-pressed="${active}" class="flex items-center gap-1.5 h-8 px-2.5 border font-mono text-[11px] tracking-[0.08em] uppercase cursor-pointer whitespace-nowrap transition-colors ${active ? "bg-accent border-accent text-paper" : "bg-transparent border-rule text-ink-2 hover:text-ink hover:border-ink"}">${esc(o.label)}<span class="tabular-nums opacity-70">${o.n}</span></button>`;
        }).join("");

      const shown = groups.filter((g: any) => skillUI.area === "all" || String(g.g) === skillUI.area);
      gridEl.innerHTML = shown.map((g: any) => {
        const expanded = skillUI.more.has(String(g.g));
        const items = expanded ? g.items : (g.items || []).slice(0, SKILL_PREVIEW);
        const hidden = (g.items || []).length - items.length;
        return `<div class="grid grid-cols-[minmax(0,120px)_minmax(0,1fr)] gap-x-6 gap-y-2 py-5 border-b border-rule items-start">`
          + `<div class="flex flex-col gap-1 pt-1">`
          + `<span class="font-mono text-[11px] tracking-[0.08em] uppercase text-accent">/${esc(g.g.toLowerCase())}</span>`
          + `<span class="font-mono text-[10.5px] text-ink-2 tabular-nums">${g.items?.length ?? 0} ${esc(ui.skillUnit || "herr.")}</span></div>`
          + `<div class="flex flex-col gap-3 min-w-0">`
          + `<div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,180px),1fr))] gap-x-5">`
          + items.map((it: string) => {
            const m = (g.meta || []).find((x: any) => x.name === it);
            const on = isDaily(g, it);
            const yr = m?.years ? `${m.years}${yearUnit}` : yearLabel(it);
            return `<div class="flex items-baseline gap-2.5 py-1.5 border-b border-dotted border-rule min-w-0">`
              + `<span aria-hidden="true" class="w-[7px] h-[7px] flex-none self-center ${on ? "bg-accent" : "bg-transparent shadow-[inset_0_0_0_1px_var(--color-ink-2)]"}"></span>`
              + `<span translate="no" class="text-[16px] leading-[1.3] break-words min-w-0">${esc(it)}${on ? `<span class="sr-only"> (${esc(ui.mapDaily || "")})</span>` : ""}</span>`
              + (yr ? `<span class="ml-auto font-mono text-[10.5px] text-ink-2 tabular-nums">${yr}</span>` : "")
              + `</div>`;
          }).join("")
          + `</div>`
          + (hidden > 0 || expanded
            ? `<button type="button" data-skill-more="${esc(g.g)}" class="self-start font-mono text-[11px] tracking-[0.08em] uppercase pb-1 px-0 border-0 border-b border-rule bg-transparent text-ink-2 cursor-pointer hover:text-ink hover:border-ink">${expanded ? esc(ui.skillLess || "Mostrar menos −") : `+ ${hidden} ${esc(ui.skillMore || "más")}`}</button>`
            : "")
          + `</div></div>`;
      }).join("");

      // Mapa del stack (columna derecha): ancho = herramientas del área respecto a la
      // mayor; relleno = parte de uso diario. Cada fila filtra la lista de la izquierda.
      const mapEl = document.getElementById("skill-map");
      const statsEl = document.getElementById("skill-stats");
      if (mapEl && statsEl) {
        const rows = groups.map((g: any) => {
          const items: string[] = g.items || [];
          return { k: String(g.g), n: items.length, d: items.filter((it) => isDaily(g, it)).length };
        });
        const most = Math.max(1, ...rows.map((r: any) => r.n));
        mapEl.innerHTML = rows.map((r: any) => {
          const active = skillUI.area === r.k;
          return `<button type="button" data-skill-area="${esc(r.k)}" aria-pressed="${active}" aria-label="${esc(r.k)}: ${r.n} · ${esc(ui.mapDaily || "")} ${r.d}" class="group grid grid-cols-[minmax(0,104px)_minmax(0,1fr)_56px] items-center gap-4 w-full py-2.5 px-0 border-0 bg-transparent text-left">`
            + `<span class="font-mono text-[11px] tracking-[0.08em] uppercase transition-colors ${active ? "text-accent" : "text-ink-2 group-hover:text-ink"}">/${esc(r.k.toLowerCase())}</span>`
            + `<span data-bar class="relative h-3 border transition-colors ${active ? "border-accent" : "border-rule group-hover:border-ink-2"}" style="width:${((r.n / most) * 100).toFixed(1)}%"><span class="absolute inset-y-0 left-0 bg-accent" style="width:${r.n ? ((r.d / r.n) * 100).toFixed(1) : 0}%"></span></span>`
            + `<span class="font-mono text-[11px] text-ink-2 tabular-nums text-right"><span class="text-accent">${r.d}</span>/${r.n}</span></button>`;
        }).join("");
        const daily = rows.reduce((n: number, r: any) => n + r.d, 0);
        const maxYears = Math.max(0, ...groups.flatMap((g: any) => (g.meta || []).map((m: any) => Number(m.years) || 0)));
        const cell = (k: string, v: string, accent = false) => `<div class="flex flex-col gap-1 py-4 pr-3"><dt class="font-mono text-[10.5px] tracking-[0.1em] uppercase text-ink-2">${esc(k)}</dt><dd class="m-0 font-display font-medium text-[clamp(24px,2.4vw,34px)] leading-none tabular-nums ${accent ? "text-accent" : ""}">${esc(v)}</dd></div>`;
        statsEl.innerHTML = cell(ui.mapTools || "", String(total)) + cell(ui.mapDaily || "", String(daily), true) + (maxYears ? cell(ui.mapYears || "", `${maxYears}${yearUnit}`) : "");
      }
    }

    function renderCertsTeaser(pg: PageData, profile: Profile) {
      const el = document.getElementById("certs-teaser");
      if (!el) return;
      const p = (pg as any)[profile] as any;
      const certs = p.certs || [];
      const groups = p.certGroups || [];
      const base = ((pg.meta as any)?.certsUrl || "#").replace(/\/+$/, "") || "#";
      // Sin datos vivos se conserva el respaldo estático (links prerenderizados).
      if (groups.length === 0 && certs.length === 0) return;
      const rows = groups.map((g: any) => {
        const items = (certs || []).filter((c: any) =>
          (c.tags || []).some((t: string) => String(t).trim().toLowerCase() === g.group),
        );
        const ys = items.map((c: any) => String(c.date || "").slice(0, 4)).filter(Boolean).sort();
        const top = [...items].sort((a: any, b: any) => String(b.date).localeCompare(String(a.date)))[0];
        const range = ys.length === 0 ? "" : ys[0] === ys[ys.length - 1] ? ys[0] : `${ys[0]}–${ys[ys.length - 1].slice(2)}`;
        return `<a href="${esc(base)}?grupo=${esc(g.group)}" class="${certRowClass}">`
          + `<span class="min-w-0 flex flex-col gap-1.5">`
          + `<span class="flex items-baseline gap-2.5"><span translate="no" class="font-display font-medium text-[22px] leading-[1.1] uppercase">${esc(g.group)}</span>`
          + `<span class="font-mono text-[11px] text-accent tabular-nums">${g.count}</span></span>`
          + (top ? `<span class="text-[14px] text-ink-2 truncate">${esc(top.title)}</span>` : "")
          + `</span>`
          + `<span class="flex flex-col items-end justify-between gap-2">`
          + `<span class="font-mono text-[12px] text-ink-2 tabular-nums">${range}</span>`
          + icon("arrow-right", "size-5") + `</span></a>`;
      }).join("");
      // Credenciales únicas: una puede pertenecer a varios grupos.
      const totalCerts = certs.length;
      const certTotal = document.getElementById("cert-total");
      if (certTotal) {
        certTotal.textContent = certs.length > 0
          ? `${totalCerts} ${(pg as any).ui?.certsCount || ""} · ${groups.length} ${(pg as any).ui?.certsGroups || ""}`
          : "";
      }
      el.innerHTML = rows;
    }



    // § 04 — estado de filtros y desplegables (mismo render que el SSR).
    const pubUI: PubState = { type: "all", year: "all", open: [], bib: [] };
    function renderPubs(pg: PageData, profile: Profile) {
      const pubs = (pg as any)[profile]?.pubs || [];
      const me = (pg as any).personal?.name || "";
      const f = document.getElementById("pubs-filters");
      const l = document.getElementById("pubs-list");
      if (f) f.innerHTML = pubFiltersHtml(pubs, pg.ui, pubUI);
      if (l) l.innerHTML = pubsHtml(pubs, pg.ui, pubUI, me);
    }
    const toggleIn = (list: string[], key: string) => {
      const i = list.indexOf(key);
      if (i >= 0) list.splice(i, 1);
      else list.push(key);
    };

    const countsFor = (pg: PageData) => ({
      fullstack: ((pg as any).fullstack?.projects || []).length,
      data: ((pg as any).data?.projects || []).length,
    });

    // § 01 — release abierto (el más reciente).
    const workUI = { open: 0 };
    function renderWork(pg: PageData, profile: Profile) {
      const el = document.getElementById("projects-list");
      if (el) el.innerHTML = workHtml((pg as any)[profile].projects || [], pg.ui, {
        caseHref,
        open: workUI.open,
        profile,
        counts: countsFor(pg),
        cvUrl: (pg as any).personal?.cvUrl || "#",
      });
    }

    // § 00 — Hero: identidad, versión y canales siguen al perfil activo.
    function renderHero(pg: PageData, profile: Profile) {
      const el = document.getElementById("hero-work");
      if (!el) return;
      const personal = (pg as any).personal || {};
      el.innerHTML = releaseHeroHtml((pg as any)[profile].projects || [], pg.ui, {
        caseHref,
        cvUrl: personal.cvUrl || "#",
        name: personal.name || "",
        role: (pg as any)[profile].role || "",
        availability: personal.availabilityLong || "",
        location: personal.location || "",
        intro: (pg as any)[profile]?.intro || "",
        profile,
        counts: countsFor(pg),
      });
    }

    // Canales del release: el hero y el riel se repintan al cambiar de perfil,
    // así que la delegación reemplaza a los listeners del render inicial.
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-release-profile]");
      if (!btn || !btn.closest("#hero-work, #projects-list")) return;
      const next = btn.dataset.releaseProfile as Profile | undefined;
      if (next) setProfile(next);
    });

    // § 06 — reloj local de la ubicación (zona IANA de site.ts o de la API).
    function tickClock() {
      document.querySelectorAll<HTMLElement>("[data-clock]").forEach((el) => {
        try {
          el.textContent = new Intl.DateTimeFormat(page.meta.lang, { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: el.dataset.clock || undefined }).format(new Date());
        } catch {
          el.textContent = "--:--";
        }
      });
    }

    window.__mgRender = (pg: PageData, profile: Profile) => {
      const p = pg[profile] as any;

      renderHero(pg, profile);
      renderWork(pg, profile);

      document.getElementById("about-list")!.innerHTML = aboutHtml(p.about || []);
      const personal = (pg as any).personal || {};
      document.getElementById("about-facts")!.innerHTML = factsHtml(personal.facts || pg.ui.facts || []);
      document.getElementById("about-quote")!.innerHTML = quoteHtml(p);
      document.getElementById("about-principles")!.innerHTML = principlesHtml(p, pg.ui);
      document.getElementById("about-now")!.innerHTML = nowHtml(p, pg.ui, (pg.meta as any).lang);
      document.getElementById("contact-dir")!.innerHTML = directoryHtml({ ...personal, hoursNote: personal.hoursNote || pg.ui.hoursNote }, p.links || [], pg.ui);
      tickClock();

      document.getElementById("notes-list")!.innerHTML = p.notes.map((nt: any) =>
        `<div class="flex gap-2.5 border-t border-rule pt-2.5"><span class="font-mono text-[11px] text-accent">${esc(nt.n)}</span>`
        + `<span class="text-[14px] leading-[1.5] text-ink-2">${esc(nt.t)}</span></div>`
      ).join("");

      renderStack(pg, profile);

      renderPubs(pg, profile);

      const letterEl = document.getElementById("letter");
      if (letterEl && p.letter) letterEl.textContent = p.letter;

      const edu = p.edu || (pg as any).edu || [];
      document.getElementById("edu-list")!.innerHTML = eduHtml(edu);

      renderCertsTeaser(pg, profile);

      const ui = (pg as any).ui || {};
      document.getElementById("exp-list")!.innerHTML = expHtml(p.exp, ui);

      const cvHref = (pg as any).personal?.cvUrl || "#";
      const heroCv = document.getElementById("hero-cv") as HTMLAnchorElement | null;
      if (heroCv) heroCv.href = cvHref;
      const rowCv = document.getElementById("cv-link") as HTMLAnchorElement | null;
      if (rowCv) rowCv.href = cvHref;
      const workCv = document.getElementById("work-cv") as HTMLAnchorElement | null;
      if (workCv) workCv.href = cvHref;
      const expCv = document.getElementById("exp-cv") as HTMLAnchorElement | null;
      if (expCv) expCv.href = cvHref;
    };

    document.getElementById("pubs-filters")?.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      const type = el.closest<HTMLElement>("[data-pub-type]")?.dataset.pubType;
      const year = el.closest<HTMLElement>("[data-pub-year]")?.dataset.pubYear;
      if (type) pubUI.type = type;
      else if (year) pubUI.year = year;
      else return;
      renderPubs(window.__mgPage ?? page, getProfile());
      stagger(document.getElementById("pubs-list"));
    });
    document.getElementById("pubs-list")?.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      const abs = el.closest<HTMLElement>("[data-pub-toggle]")?.dataset.pubToggle;
      const bib = el.closest<HTMLElement>("[data-pub-bib]")?.dataset.pubBib;
      if (abs) toggleIn(pubUI.open, abs);
      else if (bib) toggleIn(pubUI.bib, bib);
      else return;
      document.getElementById("pubs-list")?.classList.remove("mg-stagger");
      renderPubs(window.__mgPage ?? page, getProfile());
      // Solo se despliega lo que se acaba de abrir, no lo que ya estaba abierto.
      const key = abs ?? bib!;
      document.querySelectorAll<HTMLElement>("[data-unfold]").forEach((x) => x.dataset.unfold === key && x.tagName === (abs ? "P" : "PRE") && x.classList.add("mg-unfold"));
    });

    // § 00 — la chuleta escribe el comando en la terminal y lo ejecuta.
    document.getElementById("cons-cmds")?.addEventListener("click", (e) => {
      const cmd = (e.target as HTMLElement).closest<HTMLElement>("[data-term-run]")?.dataset.termRun;
      const input = document.querySelector<HTMLInputElement>("#term-main [data-term-input]");
      if (!cmd || !input) return;
      input.value = cmd;
      input.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
      input.focus({ preventScroll: true });
    });

    document.getElementById("projects-list")?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-work-row]");
      if (!btn) return;
      const i = Number(btn.dataset.workRow);
      workUI.open = workUI.open === i ? -1 : i;
      renderWork(window.__mgPage ?? page, getProfile());
      document.querySelector<HTMLElement>(`[data-work-row="${i}"]`)?.focus();
    });
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
      if (!btn || !navigator.clipboard?.writeText) return;
      const label = btn.textContent;
      navigator.clipboard.writeText(btn.dataset.copy || "").then(() => {
        btn.textContent = btn.dataset.copied || label;
        btn.dataset.done = "";
        window.setTimeout(() => { btn.textContent = label; delete btn.dataset.done; }, 1600);
      }).catch(() => {});
    });
    tickClock();
    window.setInterval(tickClock, 30_000);

    initSite(page, { spy: ["trabajo", "sobre-mi", "herramientas", "investigacion", "trayectoria", "contacto"], roleFallback: (page as any)[getProfile()].role });
    // El prerender siempre sale de la edición de Ingeniería: si el perfil guardado
    // es otro, se repinta para que hero, riel y secciones coincidan desde el inicio.
    if (getProfile() !== "fullstack") setProfile(getProfile());
    initTerminals();
    initMascot();
    initTrophies();
    initDither();
    renderStack(page, getProfile());
    renderCertsTeaser(page, getProfile());
    renderPubs(page, getProfile());

    document.getElementById("skill-areas")?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-skill-area]") as HTMLElement | null;
      if (!btn?.dataset.skillArea) return;
      skillUI.area = btn.dataset.skillArea;
      renderStack(page, getProfile());
      stagger(document.getElementById("stack-grid"));
    });
    // Mapa del stack: pulsar un área filtra; pulsar la activa vuelve a "todas".
    document.getElementById("skill-map")?.addEventListener("click", (e) => {
      const area = (e.target as HTMLElement).closest<HTMLElement>("[data-skill-area]")?.dataset.skillArea;
      if (!area) return;
      skillUI.area = skillUI.area === area ? "all" : area;
      renderStack(page, getProfile());
      stagger(document.getElementById("stack-grid"));
    });
    document.getElementById("stack-grid")?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-skill-more]") as HTMLElement | null;
      if (!btn?.dataset.skillMore) return;
      const g = btn.dataset.skillMore;
      if (skillUI.more.has(g)) skillUI.more.delete(g);
      else skillUI.more.add(g);
      document.getElementById("stack-grid")?.classList.remove("mg-stagger");
      renderStack(page, getProfile());
    });
    // DI: la fuente (mock|live) viaja en page.meta.sourceKind, inyectada por props.
    // Mock-first: con PUBLIC_USE_MOCK=true ves la plantilla sin levantar la API.
    const source = createPortfolioSource((page.meta as any)?.sourceKind ?? "mock");
    refreshHomeFromApi(page, source).catch(() => {});
  </script>
</Layout>

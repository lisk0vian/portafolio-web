---
// Certification group page: full list, local search (?q=), batch reveal.
// Prerenders with the group's data when the API answers at build.
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import { ui, pick } from "../data/content";
import type { Lang } from "../scripts/store";
import { resolvePersonal } from "../utils/personal";
import { pageUrl } from "../utils/urls";
import { apiStatusText } from "../utils/api-status";
import { CERTS_FIELDS } from "../lib/contracts";
import { createPortfolioSource } from "../lib/composition";
import { mapCertifications } from "../lib/adapters";
import { groupListHtml } from "../scripts/certs-render";

interface Props {
  lang: Lang;
  group: string;
}

const { lang, group } = Astro.props;
const t = pick(ui, lang);
const personal = resolvePersonal(lang);
const certsUrl = pageUrl(lang, "certs");

// DI en prerender: mock por defecto para build estable sin API levantada.
let initial: any[] = [];
try {
  const source = createPortfolioSource();
  initial = mapCertifications(await source.fetchCertificationsByGroup(lang, group, { limit: 50, fields: CERTS_FIELDS }));
} catch {
  initial = [];
}

const pageData = { ui: t, group, certs: initial, personal, meta: { lang, certsUrl } };
const contentJson = JSON.stringify(pageData);
const BATCH = 10;
// Lista inicial en el HTML (mismo render que el cliente): sin saltos de layout al cargar.
const html = groupListHtml(initial, "", BATCH, t);
---

<Layout title={`${group} — ${t.certsT}`} description={`${initial.length} ${t.certsCount}`} lang={lang}>
  <div class="min-h-screen bg-paper text-ink font-sans antialiased">
    <SiteHeader lang={lang} page="certs" themeLabels={`${t.light}|${t.dark}`} spyFallback={group} />

    <main class="max-w-page mx-auto px-[clamp(16px,3vw,40px)]">
      <div class="flex flex-wrap justify-between gap-x-6 gap-y-2 py-[18px] font-mono text-xs tracking-[0.06em] uppercase text-ink-2">
        <a href={`${pageUrl(lang, "home")}#herramientas`} class="no-underline">← <span>{t.skillT}</span></a>
        <span id="group-meta">{html.meta}</span>
      </div>

      <section class="py-[clamp(40px,6vw,88px)] pb-[clamp(32px,4vw,56px)] border-t border-rule">
        <h1 data-reveal="0" class="font-display font-semibold uppercase text-[clamp(36px,6vw,96px)] leading-[0.95] tracking-[-0.035em] m-0 text-balance">{group}</h1>
        <p data-reveal="100" class="text-[clamp(22px,2.4vw,34px)] leading-[1.3] text-ink-2 mt-7 mb-0 max-w-[34ch] text-pretty">{t.s2m}</p>
      </section>

      <div data-reveal="160" class="flex flex-wrap gap-3 items-center pb-6">
        <input id="group-search" type="search" placeholder={t.certSearch} aria-label={t.certSearch}
          class="flex-1 basis-[240px] min-w-0 bg-transparent border-b border-rule focus:border-accent outline-none font-mono text-[13px] py-2 placeholder:text-ink-2" />
      </div>

      <div id="group-list" class="border-b border-rule" set:html={html.list} />
      <div id="group-more" class="py-6" set:html={html.more} />
    </main>

    <footer class="border-t border-rule">
      <div class="max-w-page mx-auto px-[clamp(16px,3vw,40px)] py-5 pb-10 flex flex-wrap justify-between gap-x-6 gap-y-2.5 font-mono text-[11px] tracking-[0.06em] uppercase text-ink-2">
        <span>© 2026 {personal.name}</span>
        <span id="api-status" data-state="local">{apiStatusText("local", lang)}</span>
        <a href={pageUrl(lang, "system")} class="no-underline"><span data-t="ui.ds">{t.ds}</span> ↗</a>
      </div>
    </footer>
  </div>

  <script type="application/json" id="mg-content" set:html={contentJson} />
  <script>
    import { apiStatusText } from "../utils/api-status";
    import { initSite, type PageData } from "../scripts/site";
    import { CERTS_FIELDS } from "../lib/contracts";
    import { createPortfolioSource } from "../lib/composition";
    import { mapCertifications } from "../lib/adapters";
    import type { Lang } from "../scripts/store";
    import { groupListHtml } from "../scripts/certs-render";

    const page = JSON.parse(document.getElementById("mg-content")!.textContent || "{}") as PageData;
    const BATCH = 10;
    const state = { q: "", shown: BATCH };
    const store = { certs: ((page as any).certs || []) as any[] };

    function setStatus(mode: string) {
      const el = document.getElementById("api-status");
      if (el) {
        el.dataset.state = mode;
        el.textContent = apiStatusText(mode, document.documentElement.lang);
      }
    }

    let last = JSON.stringify(groupListHtml(store.certs, "", BATCH, (page as any).ui));
    function render() {
      const h = groupListHtml(store.certs, state.q, state.shown, (page as any).ui);
      const key = JSON.stringify(h);
      if (key !== last) {
        last = key;
        document.getElementById("group-meta")!.textContent = h.meta;
        document.getElementById("group-list")!.innerHTML = h.list;
        document.getElementById("group-more")!.innerHTML = h.more;
      }
    }
    // Un solo listener delegado: el botón puede venir del HTML del build o de un render.
    document.getElementById("group-more")?.addEventListener("click", (e) => {
      if (!(e.target as HTMLElement).closest("#group-more-btn")) return;
      state.shown += BATCH;
      render();
    });

    function syncUrl() {
      const url = new URL(window.location.href);
      if (state.q) url.searchParams.set("q", state.q);
      else url.searchParams.delete("q");
      window.history.replaceState(null, "", url);
    }

    async function refresh() {
      const lang = (((page.meta as any)?.lang) === "en" ? "en" : "es") as Lang;
      const group = (page as any).group as string;
      const source = createPortfolioSource();
      try {
        const fresh = await source.fetchCertificationsByGroup(lang, group, { limit: 50, fields: CERTS_FIELDS });
        store.certs = mapCertifications(fresh as any);
        setStatus(store.certs.length ? source.kind : "local");
      } catch {
        setStatus(store.certs.length ? "local" : "error");
      }
      render();
    }

    initSite(page);
    try {
      state.q = new URL(window.location.href).searchParams.get("q") || "";
      const input = document.getElementById("group-search") as HTMLInputElement | null;
      if (input) {
        input.value = state.q;
        input.addEventListener("input", () => {
          state.q = input.value.trim();
          state.shown = BATCH;
          syncUrl();
          render();
        });
      }
    } catch { /* sin URL: filtro vacío */ }
    render();
    void refresh();
  </script>
</Layout>

---
/* Píldora flotante de navegación por secciones. site.ts marca la sección en
   curso con aria-current (scroll-spy) y la oculta mientras el hero está a la vista. */
import { icon } from "../utils/icons";

interface Props {
  items: { n: string; l: string; h: string }[];
  label: string;
  cmdLabel: string;
}

const { items, label, cmdLabel } = Astro.props;
---

<nav
  data-dock
  data-hidden="true"
  aria-label={label}
  class="fixed z-40 bottom-4 left-1/2 -translate-x-1/2 max-w-[calc(100vw-32px)] flex items-center gap-0.5 p-1 bg-paper-2 text-ink border border-rule shadow-[0_18px_40px_-18px_rgba(0,0,0,0.5)] transition-[opacity,translate] duration-500 ease-[cubic-bezier(.16,1,.3,1)] data-[hidden=true]:opacity-0 data-[hidden=true]:translate-y-[calc(100%+24px)] data-[hidden=true]:pointer-events-none"
>
  {items.map((x) => (
    <a
      href={x.h}
      data-dock-link={x.h.replace("#", "")}
      class="flex items-center gap-2 h-9 px-2.5 lg:px-3 no-underline font-mono text-[11px] tracking-[0.1em] uppercase text-ink-2 whitespace-nowrap transition-colors hover:text-ink aria-[current=true]:bg-accent aria-[current=true]:text-paper"
    >
      <span class="tabular-nums">{x.n}</span><span data-dock-l class="hidden lg:inline">{x.l}</span>
    </a>
  ))}
  <span class="w-px h-5 bg-rule mx-1" aria-hidden="true"></span>
  <button
    type="button"
    data-open-term
    aria-label={cmdLabel}
    title={cmdLabel}
    class="flex items-center gap-1.5 h-9 px-2.5 border-0 bg-transparent text-ink-2 cursor-pointer font-mono text-[11px] hover:text-ink"
  ><Fragment set:html={icon("terminal", "size-4")} /><kbd class="hidden sm:inline font-mono">:</kbd></button>
</nav>

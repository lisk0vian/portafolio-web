---
// Caso de estudio (es/en). El contenido llega del repo de datos en build
// (`{lang}/case-studies/<slug>.json`) y se pinta por bloques: paragraph, list,
// code, diagram (Mermaid), table y metrics.
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import { caseUi, pick } from "../data/content";
import type { CaseBlockDto, CaseStudyDto } from "../lib/contracts";
import type { Lang } from "../scripts/store";
import { resolvePersonal } from "../utils/personal";
import { caseUrl, pageUrl } from "../utils/urls";

interface Props {
  lang: Lang;
  c: CaseStudyDto;
  nextTitle?: string;
}

const { lang, c, nextTitle } = Astro.props;
const t = pick(caseUi, lang);
const personal = resolvePersonal(lang);
const homeWorkHref = `${pageUrl(lang, "home")}#trabajo`;
const nextHref = c.nextCaseSlug ? caseUrl(lang, c.nextCaseSlug) : homeWorkHref;
const sections = c.sections.map((s, i) => ({ ...s, n: String(i + 1).padStart(2, "0") }));

const esc = (s: string) =>
  String(s).replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch]!);
// Markdown en línea mínimo del repo de datos: `código`, **negrita**, *cursiva* (tras escapar).
const inline = (s: string) =>
  esc(s)
    .replace(/`([^`]+)`/g, '<code class="font-mono text-[0.88em] px-1 py-0.5 bg-paper-2 rounded-sm">$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-ink">$1</strong>')
    .replace(/\*([^*]+)\*/g, "<em>$1</em>");

let fig = 0;
const caption = (text?: string) => {
  if (!text) return "";
  // Las figuras traen su propio "Fig. N —"; el resto se numera aquí.
  const label = /^Fig\.\s*\d+/.test(text) ? "" : `<strong class="font-semibold text-ink">Fig. ${++fig} —</strong> `;
  return `<figcaption class="font-serif text-[15px] text-ink-2 mt-3 text-pretty">${label}${inline(text)}</figcaption>`;
};

function block(b: CaseBlockDto): string {
  switch (b.type) {
    case "paragraph":
      return `<p class="font-serif text-body-serif m-0 text-pretty">${inline(b.text)}</p>`;
    case "list":
      return `<ul class="m-0 pl-0 list-none flex flex-col gap-3">${b.items
        .map((x) => `<li class="font-serif text-body-serif pl-5 relative text-pretty before:content-[''] before:absolute before:left-0 before:top-[0.7em] before:size-1.5 before:bg-accent">${inline(x)}</li>`)
        .join("")}</ul>`;
    case "code":
      return `<figure class="m-0 min-w-0"><div class="flex items-center justify-between gap-3 px-4 py-2 bg-term border-b border-term-rule rounded-t-term font-mono text-[11px] tracking-[0.08em] uppercase text-term-dim"><span>${esc(b.lang)}</span>`
        + (b.source ? `<a href="${esc(b.source)}" target="_blank" rel="noreferrer" class="text-term-accent no-underline hover:underline">${esc(t.source)} ↗</a>` : "")
        + `</div><pre class="m-0 bg-term text-term-ink font-mono text-[13px] leading-[1.7] p-5 rounded-b-term overflow-x-auto [font-variant-ligatures:none]"><code>${esc(b.code)}</code></pre>${caption(b.caption)}</figure>`;
    case "diagram":
      return `<figure class="m-0 min-w-0"><div class="border border-rule bg-paper-2 p-4 overflow-x-auto"><pre data-mermaid class="m-0 font-mono text-[12px] leading-[1.6] text-ink-2 whitespace-pre">${esc(b.source)}</pre></div>${caption(b.caption)}</figure>`;
    case "table":
      return `<figure class="m-0 min-w-0"><div class="overflow-x-auto border-t border-b border-rule"><table class="w-full border-collapse text-left text-[15px]">`
        + `<thead><tr>${b.head.map((h) => `<th scope="col" class="py-2.5 pr-4 border-b border-rule font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2 font-normal align-bottom">${inline(h)}</th>`).join("")}</tr></thead>`
        + `<tbody>${b.rows.map((r) => `<tr class="border-b border-rule last:border-b-0">${r.map((cell, i) => `<td class="py-3.5 pr-4 align-top ${i === 0 ? "text-ink" : "text-ink-2"}">${inline(cell)}</td>`).join("")}</tr>`).join("")}</tbody>`
        + `</table></div>${caption(b.caption)}</figure>`;
    case "metrics":
      return `<dl class="m-0 grid grid-cols-[repeat(auto-fit,minmax(min(100%,150px),1fr))] border-t border-rule">${b.items
        .map((m) => `<div class="flex flex-col-reverse gap-1.5 py-5 pr-4 border-b border-rule"><dt class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2">${esc(m.label)}</dt><dd class="m-0 font-display font-semibold text-[clamp(28px,3vw,40px)] leading-none tracking-[-0.03em] text-accent tabular-nums">${esc(m.value)}</dd></div>`)
        .join("")}</dl>`;
  }
  return "";
}

const articleHtml = sections
  .map((s) => `<section id="${esc(s.id)}" data-reveal="0" class="flex flex-col gap-6 scroll-mt-24">`
    + `<div class="flex items-baseline gap-4"><span class="font-mono text-[13px] text-accent">${s.n}</span><h2 class="font-display font-medium uppercase text-h2 m-0">${esc(s.heading)}</h2></div>`
    + s.blocks.map(block).join("")
    + `</section>`)
  .join("");

// initSite necesita el payload estándar; el caso no cambia por edición.
const contentJson = JSON.stringify({ ui: t, fullstack: {}, data: {}, personal, meta: { lang, homeUrl: pageUrl(lang, "home") } });
---

<Layout title={`${c.title} — ${t.kicker}`} description={c.deck} lang={lang}>
  <div class="min-h-screen bg-paper text-ink font-sans antialiased">
    <SiteHeader lang={lang} page="case" themeLabels={`${t.light}|${t.dark}`} spyFallback={c.title} altUrls={{ es: caseUrl("es", c.slug), en: caseUrl("en", c.slug) }} />

    <main class="max-w-page mx-auto px-[clamp(16px,3vw,40px)]">
      <div class="flex flex-wrap justify-between gap-x-6 gap-y-2 py-[18px] font-mono text-xs tracking-[0.06em] uppercase text-ink-2">
        <a href={homeWorkHref} class="no-underline">← <span>{t.back}</span></a>
        <span>{t.kicker} · {c.year}</span>
      </div>

      <section class="py-[clamp(40px,6vw,88px)] pb-[clamp(32px,4vw,56px)] border-t border-rule">
        <h1 data-reveal="0" class="font-display font-semibold uppercase text-[clamp(36px,6vw,96px)] leading-[0.95] tracking-[-0.035em] m-0 text-balance">{c.title}</h1>
        <p data-reveal="100" class="text-[clamp(20px,2.2vw,30px)] leading-[1.35] text-ink-2 mt-7 mb-0 max-w-[40ch] text-pretty">{c.deck}</p>
        <ul data-reveal="140" class="flex flex-wrap gap-1.5 mt-8 p-0 list-none" aria-label={t.stack}>
          {c.stack.map((s) => <li class="mg-chip">{s}</li>)}
        </ul>
      </section>

      <div data-reveal="160" class="grid grid-cols-2 md:grid-cols-4 border-t border-rule border-b border-rule">
        {c.meta.map((m) => (
          <div class="px-0 py-5 pr-5 flex flex-col gap-1.5 min-w-0">
            <span class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2">{m.label}</span>
            <span class="font-serif text-[19px] text-pretty">{m.value}</span>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap gap-x-10 gap-y-10 py-[clamp(56px,7vw,104px)] items-start">
        <aside class="flex-[0_1_220px] md:sticky md:top-24 flex flex-col gap-0.5 min-w-0">
          <div class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2 pb-2.5">{t.toc}</div>
          <nav aria-label={t.toc}>
            {sections.map((s) => (
              <a href={`#${s.id}`} class="flex gap-3 py-2 border-t border-rule text-sm no-underline"><span class="font-mono text-accent">{s.n}</span>{s.heading}</a>
            ))}
          </nav>
          {c.links.length > 0 && (
            <>
              <div class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2 pt-7 pb-2.5">{t.links}</div>
              {c.links.map((l) => (
                <a href={l.url} target="_blank" rel="noreferrer" class="flex justify-between gap-3 py-2 border-t border-rule text-sm no-underline hover:text-accent"><span>{l.label}</span><span aria-hidden="true">↗</span></a>
              ))}
            </>
          )}
        </aside>
        <article class="flex-1 basis-[520px] min-w-0 max-w-[76ch] flex flex-col gap-[clamp(48px,5vw,72px)]">
          <Fragment set:html={articleHtml} />
          {c.quote && <blockquote data-reveal="0" class="m-0 py-8 border-t border-rule border-b border-rule text-[clamp(24px,2.8vw,36px)] leading-[1.25] tracking-[-0.01em] text-balance">“{c.quote}”</blockquote>}
        </article>
      </div>

      <a href={nextHref} class="flex flex-wrap justify-between items-baseline gap-x-8 gap-y-3 py-[clamp(40px,5vw,64px)] border-t border-rule no-underline hover:text-accent">
        <span class="font-mono text-label uppercase text-ink-2">{t.next}</span>
        <span class="font-display font-medium uppercase text-h1">{nextTitle ?? t.back} →</span>
      </a>
    </main>

    <footer class="border-t border-rule">
      <div class="max-w-page mx-auto px-[clamp(16px,3vw,40px)] py-5 pb-10 flex flex-wrap justify-between gap-x-6 gap-y-2.5 font-mono text-[11px] tracking-[0.06em] uppercase text-ink-2">
        <span>© 2026 {personal.name}</span>
        <a href={pageUrl(lang, "system")} class="no-underline">{t.ds} ↗</a>
      </div>
    </footer>
  </div>

  <script type="application/json" id="mg-content" set:html={contentJson} />
  <script>
    import { initSite, type PageData } from "../scripts/site";
    window.__mgRender = () => {};
    initSite(JSON.parse(document.getElementById("mg-content")!.textContent || "{}") as PageData);
  </script>
  <script>
    import { renderDiagrams } from "../scripts/diagrams";
    void renderDiagrams();
  </script>
</Layout>

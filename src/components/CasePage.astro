---
// Case study template, shared by the "es" and "en" pages.
// The `lang` prop selects the locale; Astro resolves all copy at build time
// and embeds it as JSON for client-side profile switches.
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import { caseUi, caseProfiles, pick, type Profile } from "../data/content";
import type { Lang } from "../scripts/store";
import { resolvePersonal } from "../utils/personal";
import { pageUrl } from "../utils/urls";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(caseUi, lang);
const getCaseData = (profile: Profile) => pick(caseProfiles[profile], lang);
const c = getCaseData("fullstack");
const personal = resolvePersonal(lang);
const homeWorkHref = `${pageUrl(lang, "home")}#trabajo`;

const sections = c.heads.map((h: string, i: number) => ({
  n: String(i + 1).padStart(2, "0"),
  t: h,
  id: "s" + (i + 1),
  href: "#s" + (i + 1),
  body: c.bodies[i],
  hasCode: i === 2,
  hasTable: i === 3,
}));

// Locale-resolved payload for client-side profile switches (no { es, en } pairs left).
const pageData = {
  ui: t,
  fullstack: getCaseData("fullstack"),
  data: getCaseData("data"),
  personal,
  meta: { lang, homeUrl: pageUrl(lang, "home") },
};
const contentJson = JSON.stringify(pageData);
---

<Layout title={`${c.title} — ${t.kicker}`} description={c.deck} lang={lang}>
  <div class="min-h-screen bg-paper text-ink font-sans antialiased">
    <SiteHeader lang={lang} page="case" themeLabels={`${t.light}|${t.dark}`} spyFallback={c.title} />

    <main class="max-w-page mx-auto px-[clamp(20px,4vw,56px)]">
      <div class="flex flex-wrap justify-between gap-x-6 gap-y-2 py-[18px] font-mono text-xs tracking-[0.06em] uppercase text-ink-2">
        <a href={homeWorkHref} class="no-underline">← <span data-t="ui.back">{t.back}</span></a>
        <span><span data-t="ui.kicker">{t.kicker}</span> · 01 / 04</span>
      </div>

      <section class="py-[clamp(40px,6vw,88px)] pb-[clamp(32px,4vw,56px)] border-t border-ink">
        <h1 id="case-title" data-reveal="0" data-tp="title" class="font-serif font-display text-[clamp(48px,8vw,128px)] leading-[0.95] tracking-[-0.03em] m-0 text-balance">{c.title}</h1>
        <p id="case-deck" data-reveal="100" data-tp="deck" class="font-serif italic font-light text-[clamp(22px,2.4vw,34px)] leading-[1.3] text-ink-2 mt-7 mb-0 max-w-[34ch] text-pretty">{c.deck}</p>
      </section>

      <div id="case-meta" data-reveal="160" class="grid grid-cols-2 md:grid-cols-4 border-t border-rule border-b border-rule">
        {c.meta.map((m: any) => (
          <div class="px-0 py-5 pr-5 flex flex-col gap-1.5">
            <span class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2">{m.k}</span>
            <span class="font-serif text-[21px]">{m.v}</span>
          </div>
        ))}
      </div>

      <figure data-reveal="0" class="mt-[clamp(40px,5vw,72px)] mb-0">
        <div class="aspect-[16/8] min-h-[220px] mg-placeholder">
          <span id="case-figph" data-tp="figPh" class="font-mono text-xs px-3 py-1.5 bg-paper border border-rule">{c.figPh}</span>
        </div>
        <figcaption class="font-serif text-[15px] text-ink-2 mt-3"><strong class="font-semibold text-ink">Fig. 1 —</strong>{` `}<span id="case-figcap" data-tp="figCap">{c.figCap}</span></figcaption>
      </figure>

      <div class="flex flex-wrap gap-x-10 gap-y-10 py-[clamp(56px,7vw,104px)] items-start">
        <aside class="flex-[0_1_220px] md:sticky md:top-24 flex flex-col gap-0.5">
          <div data-t="ui.toc" class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2 pb-2.5">{t.toc}</div>
          <nav id="case-toc" aria-label="Contents">
            {sections.map((s: any) => (
              <a href={s.href} class="flex gap-3 py-2 border-t border-rule text-sm no-underline"><span class="font-mono text-accent">{s.n}</span>{s.t}</a>
            ))}
          </nav>
        </aside>
        <article id="case-article" class="flex-1 basis-[520px] min-w-0 max-w-prose flex flex-col gap-[clamp(48px,5vw,72px)]">
          {sections.map((s: any) => (
            <section id={s.id} data-reveal="0" class="flex flex-col gap-5 scroll-mt-24">
              <div class="flex items-baseline gap-4">
                <span class="font-mono text-[13px] text-accent">{s.n}</span>
                <h2 class="font-serif font-normal text-h2 m-0">{s.t}</h2>
              </div>
              <p class="font-serif text-body-serif m-0 text-pretty">{s.body}</p>
              {s.hasCode && (
                <figure class="m-0">
                  <pre class="m-0 bg-term text-term-ink font-mono text-[13px] leading-[1.7] p-5 rounded-term overflow-x-auto">{c.code}</pre>
                  <figcaption class="font-serif italic text-[15px] text-ink-2 mt-2.5">{c.codeCap}</figcaption>
                </figure>
              )}
              {s.hasTable && (
                <div class="border-t border-ink border-b border-ink">
                  <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] gap-4 py-2.5 border-b border-rule font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2">
                    <span>{t.metric}</span><span class="text-right">{t.before}</span><span class="text-right">{t.after}</span>
                  </div>
                  {c.rows.map((r: any) => (
                    <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] gap-4 py-4 border-b border-rule last:border-b-0 items-baseline">
                      <span class="text-[15px]">{r.m}</span>
                      <span class="font-mono text-sm text-ink-2 text-right">{r.a}</span>
                      <span class="font-mono text-[15px] font-medium text-accent text-right">{r.b}</span>
                    </div>
                  ))}
                </div>
              )}
            </section>
          ))}
          <blockquote id="case-quote" data-reveal="0" data-tp="quote" class="m-0 py-8 border-t border-ink border-b border-rule font-serif italic font-light text-[clamp(26px,3vw,38px)] leading-[1.25] tracking-[-0.01em] text-balance">“{c.quote}”</blockquote>
        </article>
      </div>

      <a href={homeWorkHref} class="flex flex-wrap justify-between items-baseline gap-x-8 gap-y-3 py-[clamp(40px,5vw,64px)] border-t border-ink no-underline hover:text-accent">
        <span class="font-mono text-label uppercase text-ink-2"><span data-t="ui.next">{t.next}</span> · 02</span>
        <span class="font-serif font-display text-h1"><span id="case-next" data-tp="next">{c.next}</span> →</span>
      </a>
    </main>

    <footer class="border-t border-ink">
      <div class="max-w-page mx-auto px-[clamp(20px,4vw,56px)] py-5 pb-10 flex flex-wrap justify-between gap-x-6 gap-y-2.5 font-mono text-[11px] tracking-[0.06em] uppercase text-ink-2">
        <span>© 2026 {personal.name}</span>
        <a href={pageUrl(lang, "system")} class="no-underline"><span data-t="ui.ds">{t.ds}</span> ↗</a>
      </div>
    </footer>
  </div>

  <script type="application/json" id="mg-content" set:html={contentJson} />
  <script>
    import { initSite, type PageData } from "../scripts/site";
    import { createPortfolioSource } from "../lib/composition";
    import type { Lang, Profile } from "../scripts/store";

    const page = JSON.parse(document.getElementById("mg-content")!.textContent || "{}") as PageData;
    const esc = (s: string) =>
      String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));

    const CASE_SLUG: Record<Profile, string> = { fullstack: "payments-platform", data: "churn-prediction" };

    // Overlay vivo vía puerto inyectado (mock|live): fallback al contenido local.
    async function overlayCase(profile: Profile) {
      try {
        const lang = ((page.meta as any)?.lang === "en" ? "en" : "es") as Lang;
        const source = createPortfolioSource();
        const live = await source.fetchCaseStudy(lang, CASE_SLUG[profile]);
        if (live.title) {
          const titleEl = document.getElementById("case-title");
          if (titleEl) titleEl.textContent = String(live.title);
          document.title = `${live.title} — ${(page as any).ui?.kicker ?? ""}`;
        }
        if (live.deck) {
          const deckEl = document.getElementById("case-deck");
          if (deckEl) deckEl.textContent = String(live.deck);
        }
        if (live.quote) {
          const quoteEl = document.getElementById("case-quote");
          if (quoteEl) quoteEl.textContent = `“${live.quote}”`;
        }
      } catch {
        // Sin API: se conserva el HTML pre-renderizado local.
      }
    }

    // Rebuild the meta grid, table of contents and article for the active profile.
    window.__mgRender = (pg: PageData, profile: Profile) => {
      const ui = pg.ui;
      const c = (pg as any)[profile];
      const secs = c.heads.map((h: string, i: number) => ({
        n: String(i + 1).padStart(2, "0"), t: h, id: "s" + (i + 1), href: "#s" + (i + 1),
        body: c.bodies[i], hasCode: i === 2, hasTable: i === 3,
      }));

      document.getElementById("case-meta")!.innerHTML = c.meta.map((m: any) =>
        `<div class="px-0 py-5 pr-5 flex flex-col gap-1.5"><span class="font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2">${esc(m.k)}</span>`
        + `<span class="font-serif text-[21px]">${esc(m.v)}</span></div>`
      ).join("");

      document.getElementById("case-toc")!.innerHTML = secs.map((s: any) =>
        `<a href="${s.href}" class="flex gap-3 py-2 border-t border-rule text-sm no-underline"><span class="font-mono text-accent">${s.n}</span>${esc(s.t)}</a>`
      ).join("");

      document.getElementById("case-article")!.innerHTML = secs.map((s: any) => {
        const code = s.hasCode
          ? `<figure class="m-0"><pre class="m-0 bg-term text-term-ink font-mono text-[13px] leading-[1.7] p-5 rounded-term overflow-x-auto">${esc(c.code)}</pre>`
            + `<figcaption class="font-serif italic text-[15px] text-ink-2 mt-2.5">${esc(c.codeCap)}</figcaption></figure>` : "";
        const table = s.hasTable
          ? `<div class="border-t border-ink border-b border-ink">`
            + `<div class="grid grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] gap-4 py-2.5 border-b border-rule font-mono text-[11px] tracking-[0.08em] uppercase text-ink-2">`
            + `<span>${esc(ui.metric)}</span><span class="text-right">${esc(ui.before)}</span><span class="text-right">${esc(ui.after)}</span></div>`
            + c.rows.map((r: any) =>
              `<div class="grid grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)] gap-4 py-4 border-b border-rule last:border-b-0 items-baseline">`
              + `<span class="text-[15px]">${esc(r.m)}</span><span class="font-mono text-sm text-ink-2 text-right">${esc(r.a)}</span>`
              + `<span class="font-mono text-[15px] font-medium text-accent text-right">${esc(r.b)}</span></div>`).join("") + `</div>` : "";
        return `<section id="${s.id}" class="flex flex-col gap-5 scroll-mt-24">`
          + `<div class="flex items-baseline gap-4"><span class="font-mono text-[13px] text-accent">${s.n}</span>`
          + `<h2 class="font-serif font-normal text-h2 m-0">${esc(s.t)}</h2></div>`
          + `<p class="font-serif text-body-serif m-0 text-pretty">${esc(s.body)}</p>${code}${table}</section>`;
      }).join("") + `<blockquote class="m-0 py-8 border-t border-ink border-b border-rule font-serif italic font-light text-[clamp(26px,3vw,38px)] leading-[1.25] tracking-[-0.01em] text-balance">“${esc(c.quote)}”</blockquote>`;
    };

    initSite(page);
    const baseRender = window.__mgRender;
    window.__mgRender = (pg: PageData, profile: Profile) => {
      (Array.isArray(baseRender) ? baseRender : [baseRender]).forEach((fn) => {
        if (typeof fn === "function") (fn as (p: PageData, pr: Profile) => void)(pg, profile);
      });
      void overlayCase(profile);
    };
    void overlayCase("fullstack");
  </script>
</Layout>

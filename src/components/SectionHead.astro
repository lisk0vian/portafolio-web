---
/* Marginalia section heading: ink rule + mono § marker + serif title. */
interface Props {
  num: string;
  metaKey?: string;
  metaFallback?: string;
  titleKey?: string;
  titleProfileKey?: string;
  titleFallback?: string;
}

const { num, metaKey, metaFallback = "", titleKey, titleProfileKey, titleFallback = "" } = Astro.props;
---

<div data-reveal="0" class="mg-section-head">
  <span>§ {num}</span><span class="text-ink-2">{metaKey ? <span data-t={metaKey}>{metaFallback}</span> : metaFallback}</span>
</div>
<h2 data-reveal="80" class="font-serif font-display text-h1 mt-6 mb-12">
  {titleKey ? <span data-t={titleKey}>{titleFallback}</span> : titleProfileKey ? <span data-tp={titleProfileKey}>{titleFallback}</span> : titleFallback}
</h2>

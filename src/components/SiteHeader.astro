---
/* Barra HUD del portafolio y las páginas de caso: nombre, sección en curso,
   hora local, edición (control segmentado), idioma y tema. El cambio de idioma
   usa enlaces Astro i18n ("/" y "/en/..."). */
import type { Lang } from "../scripts/store";
import type { SitePage } from "../utils/urls";
import { pageUrl } from "../utils/urls";
import { site } from "../data/site";
import { icon } from "../utils/icons";

interface Props {
  lang: Lang;
  page: SitePage;
  themeLabels: string;
  spyFallback?: string;
  /** URLs del selector de idioma cuando la página no es una de `SitePage` (p. ej. un caso). */
  altUrls?: { es: string; en: string };
}

const { lang, page, themeLabels, spyFallback = "", altUrls } = Astro.props;
const esUrl = altUrls?.es ?? pageUrl("es", page);
const enUrl = altUrls?.en ?? pageUrl("en", page);
const meta = "font-mono text-[11px] tracking-[0.14em] uppercase";
const seg = "h-7 px-2 sm:px-3 uppercase border-0 bg-transparent text-ink-2 cursor-pointer whitespace-nowrap transition-colors hover:text-ink data-[active=true]:bg-accent data-[active=true]:text-paper";
---

<header class="sticky top-0 z-30 bg-paper border-b border-rule">
  <span data-progress aria-hidden="true" class="absolute inset-x-0 -bottom-px h-0.5 bg-accent"></span>
  <div class="max-w-page mx-auto px-[clamp(16px,3vw,40px)] h-14 flex items-center justify-between gap-x-3 sm:gap-x-6">
    <a href={pageUrl(lang, "home")} class="flex items-center gap-2.5 font-display font-semibold text-[15px] tracking-[-0.02em] leading-none no-underline whitespace-nowrap uppercase">
      {/* Símbolo de marca "Escalera SOLID": peldaños en tinta, círculo en acento, sigue al tema. */}
      <svg viewBox="0 0 256 256" class="size-6 shrink-0" aria-hidden="true"><path fill="currentColor" d="M22 178h56v56h-56ZM100 178h56v56h-56ZM178 100h56v56h-56ZM178 22h56v56h-56Z"/><circle cx="128" cy="128" r="28" fill="var(--color-accent)"/></svg>
      <span class="sm:hidden max-[359px]:hidden">{site.firstName[0]}{site.lastName[0]}</span><span class="hidden sm:inline">{site.firstName.split(" ")[0]} {site.lastName.split(" ")[0]}</span>
      {/* El nombre completo solo para lectores de pantalla: contiene el texto visible (WCAG 2.5.3). */}
      <span class="sr-only">— {site.firstName} {site.lastName}</span>
    </a>

    <div aria-live="polite" class={`hidden md:flex flex-1 min-w-0 items-center gap-6 ${meta} text-ink-2 whitespace-nowrap`}>
      <span class="flex items-center gap-2 min-w-0">
        <span data-run-n class="text-accent">●</span><span data-run-l data-tp="role" class="overflow-hidden text-ellipsis">{spyFallback}</span>
      </span>
      <span class="hidden lg:flex items-center gap-2">
        <span class="text-ink-2/70">UTC-5</span><time data-clock={site.timezone} class="text-ink tabular-nums">--:--</time>
      </span>
    </div>

    <div class="flex items-center gap-x-1.5 sm:gap-x-4">
      <div role="group" aria-label="Edition" class={`flex items-center border border-rule p-0.5 ${meta} text-[10.5px]`}>
        <button type="button" data-set-profile="fullstack" data-profile-btn="fullstack" class={seg}><span data-t="ui.eng">Ingeniería</span></button>
        <button type="button" data-set-profile="data" data-profile-btn="data" class={seg}><span data-t="ui.dat">Datos</span></button>
      </div>
      <nav class={`flex items-center gap-1.5 ${meta}`} aria-label="Language">
        <a href={esUrl} data-lang-link hreflang="es" aria-current={lang === "es" ? "page" : undefined} class="inline-flex items-center justify-center min-h-11 no-underline text-ink-2 aria-[current=page]:text-ink aria-[current=page]:underline decoration-accent decoration-2 underline-offset-[6px]">ES</a>
        <span class="text-ink-2/60" aria-hidden="true">/</span>
        <a href={enUrl} data-lang-link hreflang="en" aria-current={lang === "en" ? "page" : undefined} class="inline-flex items-center justify-center min-h-11 no-underline text-ink-2 aria-[current=page]:text-ink aria-[current=page]:underline decoration-accent decoration-2 underline-offset-[6px]">EN</a>
      </nav>
      <button
        type="button"
        data-toggle-theme
        class={`flex items-center justify-center gap-2 h-11 min-w-9 max-[359px]:min-w-6 sm:h-8 sm:min-w-0 px-0 border-0 bg-transparent text-ink-2 cursor-pointer whitespace-nowrap hover:text-ink ${meta}`}
      ><Fragment set:html={icon("contrast", "size-4")} /><span data-theme-label={themeLabels} class="hidden sm:inline">Oscuro</span><span class="sm:hidden sr-only">{lang === "en" ? "Toggle theme" : "Cambiar tema"}</span></button>
    </div>
  </div>
</header>

/* ---------- Datos (DI): fuente por env, mock como red de seguridad ---------- */
const source = createPortfolioSource();
const mock = createPortfolioSource("mock");
async function load<T>(fn: (s: typeof source) => Promise<T>): Promise<T | undefined> {
  try {
    return await fn(source);
  } catch {
    try {
      return await fn(mock);
    } catch {
      return undefined;
    }
  }
}
const [profile, projects, skills, pubs, experience, certGroups] = await Promise.all([
  load<ProfileDto>((s) => s.fetchProfile(lang)),
  load<ProjectDto[]>((s) => s.fetchProjects(lang, { limit: 20 })),
  load<SkillGroupDto[]>((s) => s.fetchSkills(lang)),
  load<Partial<PublicationDto>[]>((s) => s.fetchPublications(lang, { limit: 20 })),
  load<ExperienceDto[]>((s) => s.fetchExperience(lang)),
  load<CertificationGroupDto[]>((s) => s.fetchCertificationGroups(lang)),
]);

const personal = resolvePersonal(lang);
const name = profile?.name ?? personal.name;
const email = profile?.email ?? personal.email;
const cvUrl = profile?.cvUrl ?? personal.cvUrl;

// 5.5 — destacado (featured con resultados) + filas del resto.
const projectList = projects ?? [];
const featured = projectList.find((p) => p.featured && p.results?.length) ?? projectList.find((p) => p.featured) ?? projectList[0];
const rows = projectList.filter((p) => p !== featured).slice(0, 2);
const featuredNo = String(projectList.indexOf(featured!) + 1).padStart(2, "0");
const rowNo = (p: ProjectDto) => String(projectList.indexOf(p) + 1).padStart(2, "0");
// 5.7 — tabla con los resultados de todos los proyectos.
const resultRows = projectList.flatMap((p) => p.results ?? []).slice(0, 3);

// 5.3 — etiquetas del destacado, métrica de otro proyecto, estado del perfil.
const tags = (featured?.stack ?? ["PyTorch", "PostgreSQL", "React"]).slice(0, 3);
const tagMetric = [...projectList].reverse().find((p) => p.metric && p !== featured)?.metric ?? "+18% CTR";
const status = profile?.availability?.split("·")[0].trim() ?? (lang === "es" ? "Disponible" : "Available");

// 5.9 — conteo por tipo de publicación.
const pubList = pubs ?? [];
const pubCounts = {
  all: pubList.length,
  journal: pubList.filter((p) => p.type === "journal").length,
  conference: pubList.filter((p) => p.type === "conference").length,
};

// 5.10 — habilidades: diarias primero, vista previa de 6.
const skillItems = (skills ?? [])
  .flatMap((g) => normalizeSkillItems(g.items as unknown[]))
  .sort((a, b) => Number(!!b.daily) - Number(!!a.daily) || (b.years ?? 0) - (a.years ?? 0));
const SKILL_PREVIEW = 6;

// 5.11 — el grupo con más certificaciones.
const certGroup = [...(certGroups ?? [])].sort((a, b) => b.count - a.count)[0];
const certsBase = pageUrl(lang, "certs").replace(/\/+$/, "");
const certRange = certGroup?.fromYear
  ? certGroup.fromYear === certGroup.toYear ? String(certGroup.fromYear) : `${certGroup.fromYear}–${certGroup.toYear}`
  : "";

// 5.12 — primera publicación.
const pub = pubList[0];
const bibtex = pub
  ? `@${pub.type === "conference" ? "inproceedings" : "article"}{${String(pub.slug ?? "ref").replace(/[^a-z0-9]+/gi, "")},\n  title={${pub.title}},\n  author={${(pub.authors ?? []).join(" and ")}},\n  ${pub.type === "conference" ? "booktitle" : "journal"}={${pub.venue}},\n  year={${pub.year}}${pub.doi ? `,\n  doi={${pub.doi}}` : ""}\n}`
  : "";

// 5.13 — actual + anterior.
const timeline = (experience ?? []).slice(0, 2).map((e) => ({
  ...e,
  period: `${e.startDate.slice(0, 4)} — ${e.current || !e.endDate ? copy.now : e.endDate.slice(0, 4)}`,
}));

// 5.14 / 5.15 / 5.16
const dropText = profile?.about?.[0] ?? (lang === "es"
  ? "Empecé haciendo sitios para amigos y terminé diseñando sistemas que mueven dinero real."
  : "I started building sites for friends and ended up designing systems that move real money.");
const pullQuote = profile?.quote ?? (lang === "es" ? "El mejor código es el que no tuviste que escribir." : "The best code is the code you didn’t have to write.");
const social = profile?.socials?.[0];
const nowBlock = profile?.now;
const nowDate = nowBlock?.updatedAt
  ? new Intl.DateTimeFormat(lang, { month: "short", year: "numeric" }).format(new Date(`${nowBlock.updatedAt}-01T12:00:00`))
  : "";


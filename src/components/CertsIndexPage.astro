---
// Certifications hub: one page, group state in `?grupo=` (deep-linkable).
// `?=todas` shows every group as its own section.
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import { ui, pick } from "../data/content";
import type { Lang } from "../scripts/store";
import { resolvePersonal } from "../utils/personal";
import { pageUrl } from "../utils/urls";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(ui, lang);
const personal = resolvePersonal(lang);
const homeUrl = `${pageUrl(lang, "home")}#herramientas`;
const systemHref = pageUrl(lang, "system");

const pageData = { ui: t, personal, meta: { lang, homeUrl, systemHref } };
const contentJson = JSON.stringify(pageData);
const now = new Date().getFullYear();
---

<Layout title={`${t.certsT} — ${personal.name}`} description={t.s2m} lang={lang}>
  <div class="min-h-screen bg-paper text-ink font-sans antialiased">
    <SiteHeader lang={lang} page="certs" themeLabels={`${t.light}|${t.dark}`} spyFallback={t.certsT} />

    <main class="max-w-page mx-auto px-[clamp(16px,3vw,40px)] pb-[clamp(64px,8vw,120px)]">
      <div data-reveal="0" class="flex flex-wrap justify-between items-baseline gap-x-6 gap-y-2 pt-3.5 border-t border-rule font-mono text-label uppercase">
        <span>§ 03.2 — <span data-t="ui.certsT">{t.certsT}</span></span>
        <span id="certs-total" class="text-ink-2"></span>
      </div>
      <h1 data-reveal="0" class="font-display font-medium uppercase text-[clamp(28px,7vw,104px)] leading-[0.98] tracking-[-0.03em] mt-6 mb-0 text-balance" data-t="ui.certsT">{t.certsT}</h1>
      <p id="certs-deck" data-reveal="60" class="text-[clamp(20px,2vw,28px)] leading-[1.35] text-ink-2 mt-4 mb-0 max-w-[40ch]"></p>

      <nav id="certs-nav" class="flex flex-wrap items-baseline gap-x-2.5 gap-y-2 py-3.5 border-y border-rule" aria-label="Grupos"></nav>
      <div id="certs-sections"></div>
    </main>

    <footer class="border-t border-rule">
      <div class="max-w-page mx-auto px-[clamp(16px,3vw,40px)] py-5 pb-10 flex flex-wrap justify-between gap-x-6 gap-y-2.5 font-mono text-[11px] tracking-[0.06em] uppercase text-ink-2">
        <span>© 2026 {personal.name}</span>
        <span id="api-status" data-state="local">datos locales</span>
        <a href={systemHref} class="no-underline"><span data-t="ui.ds">{t.ds}</span> ↗</a>
      </div>
    </footer>
  </div>

  <script type="application/json" id="mg-content" set:html={contentJson} />
  <script>
    import { initSite, type PageData } from "../scripts/site";
    import { createPortfolioSource } from "../lib/composition";
    import { CERTS_FIELDS } from "../lib/api";
    import { mapCertifications } from "../lib/adapters";
    import { getProfile, type Lang } from "../scripts/store";

    const page = JSON.parse(document.getElementById("mg-content")!.textContent || "{}") as PageData;
    const esc = (s: string) =>
      String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
    const meta = page.meta as any;
    const state = { grupo: "todas", groups: [] as any[], certs: [] as any[] };

    function setStatus(mode: string) {
      const el = document.getElementById("api-status");
      if (!el) return;
      el.dataset.state = mode;
      el.textContent = mode === "live" ? "API en vivo" : mode === "mock" ? "Mock API · datos plantilla" : mode === "error" ? "API no disponible · datos locales" : "datos locales";
    }

    function yearOf(ym: string | null | undefined) {
      return ym ? String(ym).slice(0, 4) : "";
    }

    function statusOf(c: any, ui: any) {
      if (!c.expiry) return [`${ui.certNoExp || "Sin vencimiento"}`, ""];
      const y = yearOf(c.expiry);
      const n = new Date().getFullYear();
      if (y < n) return [`${ui.certExpired2 || "Vencida"}`, ""];
      if (y === n) return [`${ui.certEnds || "Vence este año"}`, "text-accent"];
      return [`● ${ui.certValid || "Vigente"}`, "text-accent"];
    }

    function certCard(c: any, ui: any, i: number) {
      const [status, color] = statusOf(c, ui);
      const no = String(i + 1).padStart(2, "0");
      return `<article class="flex flex-col gap-4 py-7 border-b border-rule">`
        + `<div class="flex justify-between items-baseline gap-3 font-mono text-[11px] tracking-[0.08em] uppercase">`
        + `<span class="text-accent">${no}${c.category ? ` · ${esc(c.category)}` : ""}</span>`
        + `<span class="${color}">${esc(status)}</span></div>`
        + `<h2 class="font-display font-medium uppercase text-[clamp(20px,2vw,28px)] leading-[1.15] tracking-[-0.025em] m-0">${esc(c.title)}</h2>`
        + `<div class="grid grid-cols-3 border-t border-rule">`
        + `<div class="py-2.5 pr-3 flex flex-col gap-1"><span class="font-mono text-[10px] tracking-[0.08em] uppercase text-ink-2">${esc(ui.certIssued || "Emitida")}</span><span class="font-mono text-[13px] tabular-nums">${yearOf(c.date)}</span></div>`
        + `<div class="py-2.5 px-3 border-l border-rule flex flex-col gap-1"><span class="font-mono text-[10px] tracking-[0.08em] uppercase text-ink-2">${esc(ui.certExpiresLbl || "Vence")}</span><span class="font-mono text-[13px] tabular-nums">${c.expiry ? yearOf(c.expiry) : "—"}</span></div>`
        + `<div class="py-2.5 pl-3 border-l border-rule flex flex-col gap-1 min-w-0"><span class="font-mono text-[10px] tracking-[0.08em] uppercase text-ink-2">ID</span><span class="font-mono text-[12px] truncate">${esc(c.ref || "")}</span></div></div>`
        + `<div class="flex flex-wrap gap-x-3.5 gap-y-1 text-[16px] text-ink-2">${(c.skills || []).map((s: string) => `<span translate="no">${esc(s)}</span>`).join("")}</div>`
        + `<div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 mt-auto pt-1">`
        + (c.url
          ? `<a href="${esc(c.url)}" target="_blank" rel="noreferrer" class="mg-btn-primary text-[19px]"><span>${esc(ui.certVerifyCred || "Verificar credencial")}</span><span class="font-mono text-[13px] text-accent">↗</span></a>`
          : "")
        + (c.pdf && c.pdf !== "#" ? `<a href="${esc(c.pdf)}" target="_blank" rel="noreferrer" class="mg-btn-secondary">${esc(ui.certPdf || "PDF")} ↓</a>` : "")
        + `</div></article>`;
    }

    function groupCerts(group: string) {
      const g = String(group).toLowerCase();
      return state.certs.filter((c: any) => (c.tags || []).some((t: string) => String(t).trim().toLowerCase() === g));
    }

    function render() {
      const ui = (page as any).ui || {};
      const all = state.grupo === "todas";
      const groups = state.groups.length > 0
        ? state.groups
        : [...new Set(state.certs.flatMap((c: any) => c.tags || []).map((t: string) => String(t).toLowerCase()))]
            .map((g) => ({ group: g, count: groupCerts(g).length }));
      const total = state.certs.length;
      document.getElementById("certs-total")!.textContent =
        `${total} ${total === 1 ? (ui.certOne || "credencial") : (ui.certMany || "credenciales")}`;
      const deck = document.getElementById("certs-deck")!;
      deck.textContent = all
        ? (ui.certsAllDeck || "Todas las credenciales, agrupadas por área.")
        : `${groupCerts(state.grupo).length} ${groupCerts(state.grupo).length === 1 ? (ui.certOne || "credencial") : (ui.certMany || "credenciales")} · ${state.grupo}`;
      const nav = document.getElementById("certs-nav")!;
      const opts = [{ group: "todas", count: total }, ...groups];
      nav.innerHTML = `<span class="font-mono text-[10.5px] tracking-[0.1em] uppercase text-ink-2 mr-1">${esc(ui.certGroup || "Grupo")}</span>`
        + opts.map((o, i) => {
          const active = state.grupo === o.group;
          return `<span class="flex items-baseline gap-2.5">`
            + (i > 0 ? `<span class="font-serif text-ink-2" aria-hidden="true">/</span>` : "")
            + `<button type="button" data-grupo="${esc(o.group)}" aria-current="${active ? "true" : "false"}" class="text-[19px] leading-none py-0.5 px-0 border-0 bg-transparent cursor-pointer whitespace-nowrap ${active ? "text-ink underline decoration-accent decoration-[1.5px] underline-offset-[5px]" : "text-ink-2 hover:text-ink"}">${esc(o.group)}<sup class="font-mono text-[10px] ml-0.5">${o.count}</sup></button></span>`;
        }).join("");

      const sections = all
        ? groups.map((g: any) => ({ group: g.group, certs: groupCerts(g.group) })).filter((s: any) => s.certs.length > 0)
        : [{ group: state.grupo, certs: groupCerts(state.grupo) }];
      document.getElementById("certs-sections")!.innerHTML = sections.length === 0
        ? `<p class="text-[19px] text-ink-2 py-8">${esc(ui.certEmpty || "")}</p>`
        : sections.map((s: any) => {
          const head = all
            ? `<div class="flex items-baseline gap-3 mt-[clamp(40px,5vw,64px)] pb-2.5 border-b border-rule">`
              + `<span class="font-display font-medium uppercase text-[clamp(22px,2.4vw,32px)] tracking-[-0.025em]">${esc(s.group)}</span>`
              + `<span class="font-mono text-[11px] text-accent">${s.certs.length}</span></div>`
            : "";
          return `<section>${head}<div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,380px),1fr))] gap-x-[clamp(24px,3vw,48px)] mt-2">`
            + s.certs.map((c: any, i: number) => certCard(c, ui, i)).join("")
            + `</div></section>`;
        }).join("");
    }

    function syncUrl() {
      const url = new URL(window.location.href);
      if (state.grupo === "todas") url.searchParams.delete("grupo");
      else url.searchParams.set("grupo", state.grupo);
      window.history.replaceState(null, "", url);
    }

    function applyProfile() {
      const profile = getProfile();
      const p = (page as any)[profile] as any;
      state.groups = p?.certGroups || [];
      state.certs = p?.certs || [];
      // Solo se valida el grupo pedido cuando ya hay grupos (si no, se pierde ?grupo= al cargar).
      if (state.grupo !== "todas" && state.groups.length > 0 && !state.groups.some((g: any) => g.group === state.grupo)) state.grupo = "todas";
      render();
    }

    async function refresh() {
      const lang = (meta.lang === "en" ? "en" : "es") as Lang;
      const source = createPortfolioSource();
      try {
        const groups = await source.fetchCertificationGroups(lang);
        const rows = (await Promise.all(groups.slice(0, 8).map((g) =>
          source.fetchCertificationsByGroup(lang, g.group, { limit: 50, fields: CERTS_FIELDS }).catch(() => []),
        ))).flat() as any[];
        // Una credencial puede estar en varios grupos: se deduplica por slug.
        const all = mapCertifications([...new Map(rows.map((c) => [c.slug, c])).values()]);
        // Esta página no embebe perfiles; solo se cachean si existen.
        const p = (page as any)[getProfile()] as any;
        if (p) {
          p.certGroups = groups;
          p.certs = all;
        }
        state.groups = groups;
        state.certs = all;
        if (state.grupo !== "todas" && !groups.some((g) => g.group === state.grupo)) {
          state.grupo = "todas";
          syncUrl();
        }
        render();
        setStatus(all.length ? source.kind : "local");
      } catch {
        applyProfile();
        setStatus(state.certs.length ? "local" : "error");
      }
    }

    document.getElementById("certs-nav")?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-grupo]") as HTMLElement | null;
      if (!btn?.dataset.grupo) return;
      state.grupo = btn.dataset.grupo;
      syncUrl();
      render();
    });

    initSite(page);
    try {
      state.grupo = new URL(window.location.href).searchParams.get("grupo") || "todas";
    } catch { state.grupo = "todas"; }
    applyProfile();
    void refresh();
  </script>
</Layout>

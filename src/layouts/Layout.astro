---
import "@fontsource-variable/sora";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "es" | "en";
}

const { title, description, lang = Astro.currentLocale ?? "es" } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try {
        const d = document.documentElement;
        const savedTheme = localStorage.getItem("mg-theme");
        d.dataset.theme = savedTheme === "dark" ? "dark" : "light";
        d.dataset.profile = localStorage.getItem("mg-profile") === "data" ? "data" : "fullstack";
        const l = localStorage.getItem("mg-lang");
        if (l) d.lang = l;
      } catch (e) {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    <slot />
  </body>
</html>

---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "es" | "en";
}

const { title, description, lang = Astro.currentLocale ?? "es" } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem("mg-theme") || "light";
        const l = localStorage.getItem("mg-lang");
        if (l) document.documentElement.lang = l;
      } catch (e) {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    <slot />
  </body>
</html>
